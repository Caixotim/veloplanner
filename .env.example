# Intervals.icu base URL (credentials are configured in-app via Integrations modal)
NEXT_PUBLIC_INTERVALS_ICU_API_URL=https://intervals.icu

# App Configuration
NEXT_PUBLIC_APP_NAME=Cycling AI
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Optional Stage 3 conversational coach (server-side only)
# Leave unset to use the local deterministic coaching fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, for example a self-hosted provider.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional free local coach for local development. Install Ollama and pull llama3.2:1b.
# A Vercel deployment cannot reach Ollama on your Mac. For Vercel, use a reachable
# OpenAI-compatible endpoint and set OPENAI_API_KEY plus OPENAI_API_URL if needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
