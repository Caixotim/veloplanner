# Intervals.icu base URL (credentials are configured in-app via Integrations modal)
NEXT_PUBLIC_INTERVALS_ICU_API_URL=https://intervals.icu

# App Configuration
NEXT_PUBLIC_APP_NAME=Cycling AI
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Supabase Auth and database (set these in Vercel Project Settings, not in source control)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose this with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false/unset until migration and deployed two-device validation are complete.
NEXT_PUBLIC_ENABLE_CLOUD_PERSISTENCE=false
# Server-only secret; configure in Vercel as an encrypted environment variable.
INTERVALS_TOKEN_ENCRYPTION_KEY=
# Protects the Vercel Cron endpoint; configure the same secret in Vercel.
CRON_SECRET=
# Supabase Dashboard > Authentication > URL Configuration
# Site URL: https://YOUR-VERCEL-DOMAIN.vercel.app
# Redirect URL: https://YOUR-VERCEL-DOMAIN.vercel.app/api/auth/callback

# Optional Stage 3 conversational coach (server-side only)
# Leave unset to use the local deterministic coaching fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, for example a self-hosted provider.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional free local coach for local development. Install Ollama and pull qwen3:4b.
# A Vercel deployment cannot reach Ollama on your Mac. For Vercel, use a reachable
# OpenAI-compatible endpoint and set OPENAI_API_KEY plus OPENAI_API_URL if needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
